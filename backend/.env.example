DATABASE_URL=postgresql+psycopg://gradekade:local-demo-only@localhost:5433/gradekade
STORAGE_ROOT=data/files
OCR_PROVIDER=mock
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
AUTO_GRADE_CONFIDENCE_THRESHOLD=0.995
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
FRONTEND_ORIGIN=http://localhost:3000
# Internal rule thresholds: not calibrated probabilities.
AUTO_REJECT_CONFIDENCE_THRESHOLD=0.999
ALIGNMENT_MINIMUM_CONFIDENCE=0.8
CROP_PADDING_PIXELS=6
# Supported comma-separated variants: color,grayscale,contrast (each adds OCR calls)
OCR_VARIANTS=color
OCR_TIMEOUT_SECONDS=8
OCR_RETRIES=1
PHOTO_BLUR_MINIMUM=3

# Optional free CPU OCR. Install requirements-paddle.txt in a SEPARATE environment.
# OCR_PROVIDER=paddle
PADDLE_PYTHON=.venv-paddle/bin/python
PADDLE_MODEL_NAME=PP-FormulaNet-S
# Optional absolute path to already downloaded inference files (offline use).
# PADDLE_MODEL_DIR=/absolute/path/PP-FormulaNet-S
PADDLE_CACHE_ROOT=data/paddle-cache
PADDLE_CPU_THREADS=2
PADDLE_INITIALIZATION_TIMEOUT_SECONDS=180
PADDLE_INFERENCE_TIMEOUT_SECONDS=20
# PP-FormulaNet-S supplies no answer probability. Benchmark-only opt-in:
PADDLE_ALLOW_EXPERIMENTAL_AUTO_GRADE=false
PADDLE_MIN_AGREEING_VARIANTS=3
# To benchmark agreement, also set OCR_VARIANTS=color,grayscale,contrast.
